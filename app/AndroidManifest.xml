<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.seagull.carlauncher">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

    <!-- 桌面 / 基础 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 悬浮窗（L1 镜像卡片 / L3 虚拟屏卡片） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 状态/设置类（root 或特权时才有意义，普通应用申请了也无害） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Seagull"
        android:supportsRtl="false">

        <!--
            LSPosed 模块声明（批次 W，见 XposedEntry）：让 LSPosed 管理器把本 APK
            列为模块。经典入口（assets/xposed_init → XposedEntry），minversion 82
            兼容所有 LSPosed 版本；xposedscope 预填作用域，用户在管理器里可再增删。
        -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="海鸥桌面：SystemUI PiP 尺寸缩放 + 目标应用强制横屏 + 自动进画中画" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".HomeActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustNothing|stateUnchanged">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                又当默认桌面（HOME）又给个图标进 app：没有这一条，装完只在系统「默认桌面」
                选择列表里出现，应用抽屉里不显示，想点进设置只能按 Home 键。
                HOME 与 LAUNCHER 两个 intent-filter 共存是允许的，默认桌面功能不受影响。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SettingsHubActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SettingsSectionActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".VirtualDisplayActivity"
            android:exported="false"
            android:label="@string/vd_title"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".RootPanelActivity"
            android:exported="false"
            android:label="@string/root_panel_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".WindowTestActivity"
            android:exported="false"
            android:label="@string/window_test_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".MirrorRequestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/all_apps"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="搜索"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity android:name=".FolderActivity" android:exported="false"
            android:label="@string/folder_title" />
        <activity android:name=".LayoutModeActivity" android:exported="false"
            android:label="@string/layout_title" />
        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:label="@string/mirror_title"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <!-- 画中画锚点（批次 R，复刻 CarWithX PipAnchorActivity）：常驻虚拟屏的空 task，
             重钉落点 + 防空屏回收。excludeFromRecents + 独立 affinity + 透明主题。
             singleTask（批次 S）：NEW_TASK 复用锚点 task 时只保留一个实例 ——
             standard 模式下每次部署都会往锚点 task 里叠一个透明实例，永不 finish。 -->
        <activity
            android:name=".PipAnchorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.seagull.carlauncher.anchor"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".GardenActivity"
            android:exported="false"
            android:label="菜园"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <service
            android:name=".BallService"
            android:exported="false" />

        <service
            android:name=".PipProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- L1 镜像卡片服务：持有 MediaProjection 卡片的生命周期。
             运行时以 FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION 调 startForeground，
             所以清单【必须】声明同名 type —— 不声明会抛
             MissingForegroundServiceTypeException（旧注释的说法是反的：
             声明不会炸，漏声明才会炸，异常被 catch 吞掉后服务进不了前台，随即被系统杀掉）。 -->
        <service
            android:name=".WindowService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".RootShellService"
            android:exported="false" />

        <!--
            APK 自更新：安装 intent 的 Uri 走 SeagullFileProvider（见同名 java，零依赖
            自绘 FileProvider）。targetSdk 33 下 Uri.fromFile() = FileUriExposedException。
        -->
        <provider
            android:name=".SeagullFileProvider"
            android:authorities="com.seagull.carlauncher.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
