<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Seagull" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/leaf</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CardSub">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
